{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/LeKyks77/voice-destroy-language-packs/main/schemas/dictionary.schema.json",
  "title": "Voice Destroy language dictionary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "language", "aliases"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "language": { "type": "string", "pattern": "^[a-z]{2,3}_[a-z0-9]{2,8}$" },
    "aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["words", "type", "target"],
        "properties": {
          "words": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 2 }
          },
          "type": { "enum": ["block", "item", "entity", "potion", "family"] },
          "target": { "type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
