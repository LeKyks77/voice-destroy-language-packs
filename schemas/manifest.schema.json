{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/LeKyks77/voice-destroy-language-packs/main/schemas/manifest.schema.json",
  "title": "Voice Destroy language catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "languages"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 2 },
    "catalog_version": { "type": "integer", "minimum": 2 },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "language", "native_name", "variants"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]{2,3}_[a-z0-9]{2,8}$" },
          "language": { "type": "string", "minLength": 2 },
          "native_name": { "type": "string", "minLength": 2 },
          "variants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id", "name", "version", "engine", "download_url", "archive_size", "sha256",
                "license", "min_mod_version", "description", "hardware", "runtime_memory_mb", "recommended"
              ],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9_-]{2,16}$" },
                "name": { "type": "string", "minLength": 2 },
                "version": { "type": "string", "minLength": 1 },
                "engine": { "const": "vosk" },
                "download_url": { "type": "string", "format": "uri", "pattern": "^https://" },
                "archive_size": { "type": "integer", "minimum": 1 },
                "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
                "license": { "type": "string", "minLength": 1 },
                "min_mod_version": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 8 },
                "hardware": { "type": "string", "minLength": 8 },
                "runtime_memory_mb": { "type": "integer", "minimum": 1 },
                "recommended": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
