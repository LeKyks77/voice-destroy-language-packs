{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/LeKyks77/voice-destroy-language-packs/main/schemas/manifest.schema.json",
  "title": "Voice Destroy language-pack catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "packs"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "catalog_version": { "type": "integer", "minimum": 1 },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "language", "native_name", "version", "engine", "download_url",
          "archive_size", "sha256", "license", "min_mod_version"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]{2,3}_[a-z0-9]{2,8}$" },
          "language": { "type": "string", "minLength": 2 },
          "native_name": { "type": "string", "minLength": 2 },
          "version": { "type": "string", "minLength": 1 },
          "engine": { "const": "vosk" },
          "download_url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "archive_size": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "license": { "type": "string", "minLength": 1 },
          "min_mod_version": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
