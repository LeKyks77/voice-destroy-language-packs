{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/LeKyks77/voice-destroy-language-packs/main/schemas/pack.schema.json",
  "title": "Voice Destroy language source descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "language", "native_name", "version", "engine",
    "dictionary", "min_mod_version", "variants"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z]{2,3}_[a-z0-9]{2,8}$" },
    "language": { "type": "string", "minLength": 2 },
    "native_name": { "type": "string", "minLength": 2 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "engine": { "const": "vosk" },
    "dictionary": { "type": "string", "const": "dictionary.json" },
    "min_mod_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "name", "description", "hardware", "runtime_memory_mb", "recommended", "model"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]{2,16}$" },
          "name": { "type": "string", "minLength": 2 },
          "description": { "type": "string", "minLength": 8 },
          "hardware": { "type": "string", "minLength": 8 },
          "runtime_memory_mb": { "type": "integer", "minimum": 1 },
          "recommended": { "type": "boolean" },
          "model": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "upstream_url", "license", "source_page"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "upstream_url": { "type": "string", "format": "uri", "pattern": "^https://" },
              "license": { "type": "string", "minLength": 1 },
              "source_page": { "type": "string", "format": "uri", "pattern": "^https://" }
            }
          }
        }
      }
    }
  }
}
