{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/LeKyks77/voice-destroy-language-packs/main/schemas/pack.schema.json",
  "title": "Voice Destroy language-pack source descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "language", "native_name", "engine", "model", "dictionary"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z]{2,3}_[a-z0-9]{2,8}$" },
    "language": { "type": "string", "minLength": 2 },
    "native_name": { "type": "string", "minLength": 2 },
    "engine": { "const": "vosk" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "upstream_url", "license"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "upstream_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "license": { "type": "string", "minLength": 1 },
        "source_page": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "dictionary": { "type": "string", "minLength": 1 }
  }
}
